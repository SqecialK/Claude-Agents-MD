# Copy this file to .env and fill in your own values. .env is gitignored.

# Reserved for future LLM-assisted personalization (not required today).
OPENROUTER_API_KEY=

# Google Sheets target — set ONE of these two:
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Path to the Google service account credentials file.
GOOGLE_CREDENTIALS_PATH=credentials.json
